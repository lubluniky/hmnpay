# hmnpay deployment settings. Copy to .env and edit.
# Everything about the instance itself (operator account, network, RPC
# endpoints, wallet xpub, merchant identity) is configured in the first-run
# setup wizard and stored in the database, not here.
# Every variable has a matching flag of "hmnpay serve" (hmnpay serve -h).

# --- Server ---
# Address to listen on. In docker compose this is fixed to :8080 inside the
# container; change HMNPAY_HOST_PORT instead.
HMNPAY_LISTEN=:8080
# Host port docker compose publishes (compose only).
HMNPAY_HOST_PORT=8080
# Host interface docker compose publishes on (compose only). 127.0.0.1 keeps
# the port off the network (Docker-published ports bypass ufw/firewalld);
# put a reverse proxy on the host in front. 0.0.0.0 publishes on every
# interface: only deliberately, behind TLS, after setup.
HMNPAY_BIND=127.0.0.1
# Directory holding the SQLite database (hmnpay.db + -wal + -shm). Back it up.
# Fixed to /data in the container image.
HMNPAY_DATA_DIR=./data
# External base URL, e.g. https://pay.example.com. Decides the session
# cookie's Secure flag, the origin trusted for dashboard writes, the Host
# name the API answers for, and the default public URL offered by the setup
# wizard. Empty: derived per request, and the API only answers for
# localhost and IP-address Host headers.
# BEHIND A TLS REVERSE PROXY YOU MUST SET BOTH HMNPAY_PUBLIC_URL AND
# HMNPAY_TRUSTED_PROXIES (otherwise cookies are not Secure, client IPs are
# the proxy's, and rate limits apply to the proxy as a whole).
HMNPAY_PUBLIC_URL=
# Comma-separated extra Host names the API answers for (without port), e.g.
# an internal name a load balancer uses. The public URL's host, localhost
# and IP addresses always work; any other Host gets 421 (DNS-rebinding
# protection).
HMNPAY_ALLOWED_HOSTS=
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For /
# X-Forwarded-Proto are believed, e.g. 172.16.0.0/12 for a proxy container.
# Empty trusts nobody (client IPs are socket addresses).
HMNPAY_TRUSTED_PROXIES=
# Comma-separated extra origins allowed to make cookie-authenticated writes
# (e.g. http://localhost:3000 for a dashboard dev server).
HMNPAY_TRUSTED_ORIGINS=
# Comma-separated origins allowed cross-origin API access with bearer tokens
# (never with cookies).
HMNPAY_CORS_ORIGINS=
# true: any origin may script against the public checkout endpoints.
HMNPAY_PUBLIC_CORS=false
# DEVELOPMENT ONLY — never set this in production. The origin of a web
# interface dev server ("pnpm dev", http://localhost:3000) to reverse-proxy
# every non-API path to, instead of the interface built into the binary.
# The upstream then serves every page of this origin (dashboard, setup,
# checkout): whatever script it serves runs with the operator's session, so
# it is trusted completely. The server logs a warning at start while this
# is set. It does what it can to bound that trust: cookies, API keys and
# the setup token are not forwarded; the upstream cannot set cookies; its
# pages get the server's security headers and a development
# Content-Security-Policy (which, unlike the real one, allows inline
# scripts and eval, because a dev server needs them). Leave it empty in
# production: the binary serves the interface that is built into it (or, if
# it was compiled without one, a status page that says so).
HMNPAY_WEB_UPSTREAM=
# The upstream must be on this machine (localhost, 127.0.0.1, [::1]). true
# allows another host, for example a dev server in a second container;
# the connection to it is then part of what you trust. Development only.
HMNPAY_WEB_UPSTREAM_ALLOW_REMOTE=false
# How long a graceful shutdown may take (Go duration).
HMNPAY_SHUTDOWN_TIMEOUT=30s

# --- First-run setup ---
# Until setup is completed, claiming the instance requires this token.
# Empty (recommended): a fresh random token is generated at every start and
# printed once to stderr in a plain-text banner (docker compose logs
# hmnpay); it is never written to the structured log. If set: at least 20
# random characters (openssl rand -hex 16); it is then not printed.
HMNPAY_SETUP_TOKEN=

# --- Logging ---
# debug, info, warn or error.
HMNPAY_LOG_LEVEL=info
# text or json.
HMNPAY_LOG_FORMAT=text

# --- Webhook egress (SSRF protection) ---
# Anyone holding an API key with the webhooks:manage scope chooses webhook
# URLs and sees the responses, so internal destinations are refused by
# default. Link-local and cloud-metadata addresses are always refused.
# true: allow RFC 1918 / CGNAT / unique-local destinations (not loopback).
HMNPAY_WEBHOOK_ALLOW_PRIVATE=false
# Comma-separated loopback/private CIDRs allowed anyway, e.g. 127.0.0.1/32
# when the shop runs on the same host. Preferred over the switch above.
HMNPAY_WEBHOOK_ALLOWED_PREFIXES=
# true: refuse plain-http webhook URLs.
HMNPAY_WEBHOOK_REQUIRE_HTTPS=false

# --- Chain ---
# true: the setup wizard's RPC probe refuses loopback/private addresses.
# Until setup is completed anyone who can reach the instance can trigger a
# probe; enable this if the instance is exposed before setup and you do not
# use a node on localhost/LAN.
HMNPAY_RPC_DENY_PRIVATE=false
# Cross-check mode of the chain watcher: auto, best-effort or strict.
# auto (recommended) confirms every transfer and revert with a second
# endpoint when two or more are configured.
HMNPAY_CHAIN_VERIFY=auto
# Chain heads whose block time is more than this ahead of the server clock
# are refused. Symptom of a wrong clock: payments stay "confirming"/never
# confirm and node status shows refused heads. Fix time sync (NTP/chrony)
# first; "off" disables the check as a last resort.
HMNPAY_MAX_HEAD_TIME_AHEAD=2m
# Pause between chain scans while a payment is open or a transfer is
# waiting for its confirmations (1s to 30s). A payment is detected half of
# this later on average. Every scan costs 7 RPC calls on each of two
# endpoints: about 185,000 calls a day and endpoint at 3s, half that at 6s.
# See "RPC usage" in the README before you change it for a provider that
# bills by the call.
HMNPAY_POLL_INTERVAL=3s
# Pause between chain scans while no payment is open: the watch list is
# empty (idle), or holds only the addresses of closed payments, which stay
# on it for late funds — 7 days after a paid one, an hour after an unpaid
# one expired (quiet). Creating a payment ends the pause at once, so
# detection is not slower. What it delays: money sent to an already-closed
# payment is noticed up to this long after it is mined. About 20,000 calls
# a day and endpoint at 30s while idle, 26,000 while quiet. From the poll
# interval up to 5m; "off" (or the poll interval) scans at the poll
# interval all the time.
HMNPAY_IDLE_POLL_INTERVAL=30s
